# Copy to .env (or .env.local) in this directory. Vite only reads env files from the client's
# own root, not the repo-root .env the server uses — these two are separate on purpose.
# Restart `npm run dev` after changing this file; Vite only reads it at startup.

# Same value as the server's GOOGLE_CLIENT_ID in the repo-root .env — see that file's comment
# for how to create one. Leave unset to hide the "Continue with Google" button entirely.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Only needed for a deployed build pointing at a non-localhost API (set this in your host's
# dashboard, e.g. Vercel's Environment Variables, not here) — local dev falls back to
# http://localhost:5000/api automatically.
# VITE_API_URL=https://your-api-host.example.com/api
