# Copy this file to .env in the repo root and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Server ---
PORT=5000
# Comma-separated origins allowed to call the API (used by CORS config)
CLIENT_URL=http://localhost:5173

# --- MongoDB (primary datastore: users, brand briefs, content drafts, canvas, analytics) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/verve

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- AI ---
GEMINI_API_KEY=your-gemini-api-key

# --- PostgreSQL (billing/subscriptions only — see server/prisma/schema.prisma) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verve_billing

# --- Redis (optional — caching layer degrades gracefully if unset) ---
REDIS_URL=redis://localhost:6379

# --- Stripe (test mode — https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- SMTP (password reset emails — optional; without it, reset links are logged to the
#     server console instead, so the feature still works end-to-end in local dev) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=Verve AI <no-reply@verve.ai>
